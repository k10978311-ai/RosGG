			<Arg>	ENTITY_ID	</Arg>
		</inviteTeammateAsBornFollower>
		<refuseFollowBornWithOther> <Exposed/>
			<Arg>	ENTITY_ID	</Arg>
			<Arg>	STRING		</Arg>
		</refuseFollowBornWithOther>
		<reqBornWithTeammate> <Exposed/>
			<Arg>	ENTITY_ID	</Arg>
		</reqBornWithTeammate>
		<cancelBornWithTeammate> <Exposed/>
			<Arg>	ENTITY_ID	</Arg>
		</cancelBornWithTeammate>
		<onConfirmKickFollowers> <Exposed/>
		</onConfirmKickFollowers>
		<changeBornFollowTarget>
			<Arg>	ENTITY_ID	</Arg>
		</changeBornFollowTarget>
		<resetStatusBeforeBorn>
		</resetStatusBeforeBorn>
	</CellMethods>
	<ClientMethods>
		<resFallFollowInfo>
			<Arg>	ENTITY_ID	</Arg>
			<Arg>	ENTITY_ID	</Arg>
			<Arg>	ENTITY_ID	</Arg>
			<Arg>	INT8	</Arg>
			<Arg>	ARRAY <of>	ENTITY_ID	</of>	</Arg>
		</resFallFollowInfo>

		<fallFollowInvite>
			<Arg>	ENTITY_ID	</Arg>
		</fallFollowInvite>

		<beginFallFollow>
			<Arg>	VECTOR3		</Arg>
		</beginFallFollow>

		<endFallFollow>
		</endFallFollow>
		<onInvitedToBornTogether>
			<Arg>	STRING		</Arg>
			<Arg>	ENTITY_ID	</Arg>
			<Arg>	INT32		</Arg>
