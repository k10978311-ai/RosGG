        <updateTitanTokenTime>
        	<Arg>           INT32            </Arg>
        </updateTitanTokenTime>

        <syncTitanTokenDict>
        	<Arg>           PYTHON            </Arg>
        </syncTitanTokenDict>
	</ClientMethods>
</root>

