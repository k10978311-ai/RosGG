			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
        </getOtherTokenAward>

		<updateTitanTokenDict>
			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
			<Arg>	BOOL	</Arg>
		</updateTitanTokenDict>

