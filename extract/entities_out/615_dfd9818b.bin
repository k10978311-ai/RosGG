			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
		</sendTokenGift>

		<sendAllPlayerTokenTips>
			 <Arg>       STRING      </Arg>
			 <Arg>       STRING      </Arg>
			 <Arg>	INT32	</Arg>
		</sendAllPlayerTokenTips>

		<updateTeamChristmasBellAmount>
			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
		</updateTeamChristmasBellAmount>

