			<Type>		PYTHON		</Type>
			<Flags>		ALL_CLIENTS	</Flags>
			<Default>	{}		</Default>
		</titanTokenDict>
		<findNpcEntIDList>
			<Type>	ARRAY <of>	INT32	</of>	</Type>
			<Flags>		ALL_CLIENTS		</Flags>
