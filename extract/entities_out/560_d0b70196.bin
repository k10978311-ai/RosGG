<root>
	<Implements>
		<Interface>	iRos2HideoutBuilding	</Interface>
		<Interface>	iRos2AthleteTask	</Interface>
		<Interface>	iRos2Currency		</Interface>
		<Interface>	iRos2PackageAthlete	</Interface>
