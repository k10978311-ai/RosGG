		<Interface>	iDtsRos2PropAthlete	</Interface>
		<Interface>	iRos2LimitTimeActivity	</Interface>
		<Interface> iRos2BingoActivity </Interface>
	</Implements>
	<Properties>
		<!-- 带到下赛季的数据 -->
		<ros2NextSeasonData>
			<Type> PYTHON </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> {} </Default>
			<PersistentMongo> true </PersistentMongo>
		</ros2NextSeasonData>
		<!-- Ros2阵营选择 -->
		<ros2Camp>
			<Type> INT8 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
		</ros2Camp>
		<defenderFatigueValue>	<!-- 疲劳值 -->
			<Type> INT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<PersistentMongo> true </PersistentMongo>
		</defenderFatigueValue>
		
		<scavValidIdentity>
		    <Type> ARRAY <of>	INT32	</of> </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> [] </Default>
			<PersistentMongo> true </PersistentMongo>
		</scavValidIdentity>

		<finishedDtsRos2Training>
			<Type>		INT8		</Type>
			<Flags>		BASE_AND_CLIENT	</Flags>
			<Default> 0 </Default>
			<PersistentMongo>	true			</PersistentMongo>
		</finishedDtsRos2Training>

		<!-- 藏身所外的系统功能开放 -->
		<ros2SystemOpen>
			<Type> PYTHON </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> {} </Default>
			<PersistentMongo> true </PersistentMongo>
		</ros2SystemOpen>

		<!-- 任务记录辅助数据 -->
		<loginRos2TimeStamp> <!-- 登陆任务辅助时间戳 -->
			<Type> INT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<PersistentMongo> true </PersistentMongo>
		</loginRos2TimeStamp>
		<!-- ros2每日更新可使用的时间戳 -->
		<ros2DailyRefreshTimeStamp>
			<Type> INT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<PersistentMongo> true </PersistentMongo>
		</ros2DailyRefreshTimeStamp>
		<!-- ROS2注册时间 -->
		<registerROS2Time>
