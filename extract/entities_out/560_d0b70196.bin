				<layoutInfo> {} </layoutInfo>
				<_packageCapacity> 0 </_packageCapacity>
				<unlockState> 0 </unlockState>
				<bootyBoxID> 0 </bootyBoxID>
			</Default>
			<PersistentMongo> true </PersistentMongo>
		</dtsRos2BootyBox0>
		<dtsRos2BootyBox1>
			<Type> DTS_ROS2_BOOTY_BOX </Type>
