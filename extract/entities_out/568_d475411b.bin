<root>
	<Parent>	BattleGroundSpace		</Parent>
	<Implements>
		<Interface>	iBattleGroundRos2TaskNpcManager	</Interface>
		<Interface>	iBattleGroundRos2ActivitySpace	</Interface>
	</Implements>
	<ClientName>	BattleGroundRos2Space	</ClientName>
	
	<Properties>
		<attackerEvacuationAreas>
			<Type>	ARRAY <of>  ROS2_EVACUATION_POINT   </of>   </Type>
			<Flags>	    ALL_CLIENTS		</Flags>
		</attackerEvacuationAreas>
		<defenderEvacuationAreas>
			<Type>	ARRAY <of>  ROS2_EVACUATION_POINT   </of>   </Type>
			<Flags>	    ALL_CLIENTS		</Flags>
		</defenderEvacuationAreas>
		<commonEvacuationAreas>
			<Type>	ARRAY <of>  ROS2_EVACUATION_POINT   </of>   </Type>
			<Flags>	    ALL_CLIENTS		</Flags>
		</commonEvacuationAreas>
		<attackerEvacuationID>
			<Type>	ARRAY <of>  INT32   </of>   </Type>
			<Flags>	    ALL_CLIENTS		</Flags>
		</attackerEvacuationID>
		<commonEvacuationID>
			<Type>	ARRAY <of>  INT32   </of>   </Type>
			<Flags>	    ALL_CLIENTS		</Flags>
		</commonEvacuationID>
		<defenderEvacuationID>
			<Type>	ARRAY <of>  INT32   </of>   </Type>
			<Flags>	    ALL_CLIENTS		</Flags>
		</defenderEvacuationID>
		<suppressList>
			<Type>		PY_DICT		</Type>
			<Flags>		CELL_PUBLIC	</Flags>
			<Default>	{}		</Default>
		</suppressList>
		<hatredRegion>
			<Type>	ARRAY <of>  PYTHON   </of>   </Type>
			<Flags>	    ALL_CLIENTS		</Flags>
		</hatredRegion>
		<canAttackerJoin>
			<Type>		BOOL			</Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</canAttackerJoin>
		<canDefenderJoin>
			<Type>		BOOL			</Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</canDefenderJoin>
		<curLevelTolerance>
			<Type>	ARRAY <of>  INT32   </of>   </Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</curLevelTolerance>
		<levelTolerance>
			<Type>		INT32			</Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</levelTolerance>
		<attackerLeftNum>
			<Type>		INT32			</Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</attackerLeftNum>
		<defenderLeftNum>
			<Type>		INT32			</Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</defenderLeftNum>
		<rankType>
			<Type>		INT8			</Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</rankType>
		<rankType>
			<Type>		INT8			</Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</rankType>
		<roomInitLevel>
			<Type>		INT32			</Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</roomInitLevel>
		<attackerTeams>
			<Type>	ARRAY <of>  INT64   </of>   </Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</attackerTeams>
		<defenderTeams>
			<Type>	ARRAY <of>  INT64   </of>   </Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</defenderTeams>
		<gidToCamp>
			<Type>	PYTHON		</Type>
			<Flags>	ALL_CLIENTS	</Flags>
			<Default>	{}	</Default>
		</gidToCamp>
		<attackerOpenLeftTime>
			<Type>		INT32		</Type>
			<Flags>		ALL_CLIENTS	</Flags>
			<Default>	60	</Default>
		</attackerOpenLeftTime>
		
		<dtsRos2AvatarDiscardInsuredItem>
			<Type>		PYTHON		</Type>
			<Flags>		CELL_PUBLIC	</Flags>
			<Default>	{}	</Default>
		</dtsRos2AvatarDiscardInsuredItem>
