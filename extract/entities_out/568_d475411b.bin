			<Type>		PYTHON	</Type>
			<Flags>		ALL_CLIENTS	</Flags>
			<Default>	[]		</Default>
		</attackerBornPoint>
		<defenderBornPoint>
			<Type>		PYTHON	</Type>
			<Flags>		ALL_CLIENTS	</Flags>
			<Default>	{}		</Default>
		</defenderBornPoint>
