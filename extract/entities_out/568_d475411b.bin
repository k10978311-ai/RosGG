			<Type>		PY_DICT   </Type>
			<Flags>		CELL_PUBLIC	</Flags>
		</defenderAddToleranceTimerID>
		<defenderEnterPrepareTimerID>
			<Type>	ARRAY <of>  INT32   </of>   </Type>
			<Flags>		CELL_PUBLIC	</Flags>
		</defenderEnterPrepareTimerID>
		<defenderEnterCloseTimerID>
			<Type>	ARRAY <of>  INT32   </of>   </Type>
			<Flags>		CELL_PUBLIC	</Flags>
		</defenderEnterCloseTimerID>
		<defenderEnterStartTimerID>
			<Type>	ARRAY <of>  INT32   </of>   </Type>
			<Flags>		CELL_PUBLIC	</Flags>
		</defenderEnterStartTimerID>
		<defenderEnterLeftTime>
			<Type>		PYTHON	</Type>
			<Flags>		ALL_CLIENTS	</Flags>
			<Default>	{}		</Default>
		</defenderEnterLeftTime>
		<hatredNoToRobot>
			<Type>		PYTHON	</Type>
			<Flags>		CELL_PUBLIC	</Flags>
			<Default>	{}		</Default>
		</hatredNoToRobot>
		<ros2GameEndForceRecycleTimerID>
			<Type>		INT32		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	0		</Default>
		</ros2GameEndForceRecycleTimerID>
		<dtsAirDropsPos>
			<Type>		ARRAY <of>  VECTOR3   </of> 	</Type>
			<Flags>		ALL_CLIENTS	</Flags>
		</dtsAirDropsPos>
		<defenderRobot>
			<Type>	ARRAY <of>  INT64   </of>   </Type>
			<Flags>		ALL_CLIENTS	</Flags>
			<Default>	[]		</Default>
		</defenderRobot>
		<defenderPlayer>
			<Type>	ARRAY <of>  INT64   </of>   </Type>
			<Flags>		ALL_CLIENTS	</Flags>
			<Default>	[]		</Default>
		</defenderPlayer>
		<defenderEnterEffect>
			<Type>		PYTHON	   </Type>
			<Flags>		CELL_PRIVATE	</Flags>
		</defenderEnterEffect>
		<hasLoadedEvacuationPoint>
			<Type>	BOOL </Type>
			<Flags>	ALL_CLIENTS	</Flags>
		</hasLoadedEvacuationPoint>

		<ros2Season>
			<Type>		INT8			</Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</ros2Season>
		<patrolGroup>
			<Type>		PYTHON		    </Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</patrolGroup>
		<patrolGroupLeader>
			<Type>		PYTHON		    </Type>
			<Flags>		CELL_PUBLIC		</Flags>
		</patrolGroupLeader>
	</Properties>

	<CellMethods>
		<chatToAllBattleground>
			<Arg>     INT32         </Arg>  <!-- channel -->
			<Arg>     STRING        </Arg>  <!-- content -->
			<Arg>     CHAT_RECIVER  </Arg>  <!-- sender -->
			<Arg>     CHAT_PARAMS   </Arg>  <!-- params -->
		</chatToAllBattleground>
		<gmCreateRos2Robot>
			<Arg>		VECTOR3			</Arg>
			<Arg>		INT32			</Arg>
		</gmCreateRos2Robot>
		<createRos2HitRobot>
			<Arg>		VECTOR3			</Arg>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
		</createRos2HitRobot>
		<addSuppressList>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
		</addSuppressList>
		<delSuppressList>
			<Arg>		INT32			</Arg>
		</delSuppressList>
		
		<reportDtsRos2AvatarInsuredItem>
			<Arg>		INT32		</Arg>
			<Arg>		PYTHON		</Arg>
		</reportDtsRos2AvatarInsuredItem>

		<onDtsRos2InsuredItemPickedup>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
			<Arg>		STRING			</Arg>
		</onDtsRos2InsuredItemPickedup>
		
		<checkRos2GameEnd>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
		</checkRos2GameEnd>
		
		<leaveRos2BattleTreasure>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
		</leaveRos2BattleTreasure>

		<batchDiscardProp>
			<Arg>		PYTHON			</Arg>
			<Arg>		VECTOR3			</Arg>
		</batchDiscardProp>
		<requestBeforeMapInfo>
			<Arg>		INT32		</Arg>
			<Arg>		INT32		</Arg>
		</requestBeforeMapInfo>
		<broadcastHatredToRobot>
			<Arg>		INT32		</Arg>
			<Arg>		INT32		</Arg>
		</broadcastHatredToRobot>
		<robotOpenElement>
			<Arg>		INT32			</Arg>
			<Arg>		INT8			</Arg>
		</robotOpenElement>
		<addDefenderPlayerNum>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
		</addDefenderPlayerNum>
		<createSkateBoardForAvatar>
			<Arg>		ENTITY_ID		</Arg>
			<Arg>		VECTOR3			</Arg>
			<Arg>		VECTOR3			</Arg>
			<Arg>		FLOAT			</Arg>
			<Arg>		FLOAT			</Arg>
			<Arg>		INT32			</Arg>
		</createSkateBoardForAvatar>
		<createFortressForAvatar>
			<Arg>		ENTITY_ID		</Arg>
			<Arg>		VECTOR3			</Arg>
			<Arg>		VECTOR3			</Arg>
			<Arg>		INT32			</Arg>
		</createFortressForAvatar>

		<requestAllPlayersInfoForComplaint>
			<Arg>		INT32			</Arg>
			<Arg>		MAILBOX			</Arg>
		</requestAllPlayersInfoForComplaint>
	</CellMethods>

	<ClientMethods>
	</ClientMethods>

	<BaseMethods>
	</BaseMethods>
</root>
