<root>
	<Properties>
		<rankRecord>
			<Type>	PLAYER_RANK_RECORD	</Type>
			<Flags>	BASE_AND_CLIENT		</Flags>
			<Persistent>	true		</Persistent>
		</rankRecord>
		<score>
			<Type>	SCORE		</Type>
			<Flags>	BASE_AND_CLIENT	</Flags>
			<Persistent>	true		</Persistent>
		</score>
		<scoreRank>
			<Type>	INT32		</Type>
			<Flags>	BASE_AND_CLIENT	</Flags>
			<Default>	-1		</Default>
			<PersistentMongo>	true		</PersistentMongo>
		</scoreRank>
		<maxScore>
			<Type>	INT64		</Type>
			<Flags>	BASE_AND_CLIENT		</Flags>
			<Persistent>	true		</Persistent>
			<Default>	-1		</Default>
		</maxScore>
		<ownSeasonID>
			<Type>	INT32		</Type>
			<Flags>	BASE_AND_CLIENT		</Flags>
			<Persistent>	true		</Persistent>
			<Default>	0		</Default>
		</ownSeasonID>
		<seasonMaxScore>
			<Type>	PY_DICT		</Type>
			<Flags>	BASE		</Flags>
			<Persistent>	true		</Persistent>
			<Default>	{}		</Default>
		</seasonMaxScore>

		<hasNewInfo>
			<Type>	BOOL		</Type>
			<Flags>	BASE_AND_CLIENT		</Flags>
			<Persistent>	true		</Persistent>
		</hasNewInfo>

		<firstLevelUpTime>
			<Type>	PYTHON		</Type>
			<Flags>	BASE_AND_CLIENT	</Flags>
			<Default>	{}		</Default>
			<PersistentMongo>	true		</PersistentMongo>
		</firstLevelUpTime>
		
		<seasonFirstLevelUpTime>
			<Type>	PYTHON		</Type>
			<Flags>	BASE_AND_CLIENT	</Flags>
			<Default>	{}		</Default>
			<PersistentMongo>	true		</PersistentMongo>
		</seasonFirstLevelUpTime>

		<hasReachKingSection>
			<Type>	PYTHON		</Type>
			<Flags>	BASE_AND_CLIENT	</Flags>
			<Default>	{}		</Default>
			<PersistentMongo>	true		</PersistentMongo>
		</hasReachKingSection>

		<!-- 娱乐分 -->
		<entertainScore>
			<Type> SCORE </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<PersistentMongo> true </PersistentMongo>
		</entertainScore>
		<entertainRank>
			<Type> INT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 1 </Default>
			<PersistentMongo> true </PersistentMongo>
		</entertainRank>
		<entertainScoreGotThisWeek>
			<Type> SCORE </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<PersistentMongo> true </PersistentMongo>
		</entertainScoreGotThisWeek>
		<entertainRewardClaimList> <!-- 领取过奖励的rank ID -->
			<Type> ARRAY <of> INT32 </of> </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> [] </Default>
			<PersistentMongo> true </PersistentMongo>
		</entertainRewardClaimList>
		<hasClearEntertainInfoThisSeason>
			<Type> BOOL </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> True </Default>
			<PersistentMongo> true </PersistentMongo>
		</hasClearEntertainInfoThisSeason>
		<entertainShowNewBadge>
			<Type> BOOL </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 1 </Default>
			<PersistentMongo> true </PersistentMongo>
		</entertainShowNewBadge>
		<!-- 赛季冲分奖励 -->
		<seasonBountyRefreshTimes>
			<Type> PYTHON </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> {} </Default>
			<PersistentMongo> true </PersistentMongo>
		</seasonBountyRefreshTimes>
		<seasonBountyFreeCash>
			<Type> FLOAT </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<PersistentMongo> true </PersistentMongo>
		</seasonBountyFreeCash>
		<seasonBountyCashCliamedDict>  <!-- 用于核对发放奖励 -->
			<Type> PYTHON </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> {} </Default>
			<PersistentMongo> true </PersistentMongo>
		</seasonBountyCashCliamedDict>
		<seasonBountyFilledInfo>
			<Type> BOOL </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<PersistentMongo> true </PersistentMongo>
		</seasonBountyFilledInfo>
	</Properties>
	<BaseMethods>
		<requireRankList> <Exposed/>
			<Arg>	INT32		</Arg>	<!-- rank type -->
			<Arg>	INT32		</Arg>	<!-- buffer version -->
			<Arg>	INT32		</Arg>	<!-- buffer length-->
			<Arg>	BOOL		</Arg>	<!-- next batch -->
		</requireRankList>
		<requireLastRankList> <Exposed/>
			<Arg>	INT32		</Arg>	<!-- rank type -->
			<Arg>	INT32		</Arg>	<!-- buffer version -->
			<Arg>	INT32		</Arg>	<!-- buffer length-->
			<Arg>	BOOL		</Arg>	<!-- next batch -->
		</requireLastRankList>
		<onGetTopList>
			<Arg>		INT32		</Arg>
			<Arg>		INT32		</Arg>
			<Arg>		PYTHON		</Arg>
			<Arg>		INT32		</Arg>
		</onGetTopList>
		<onGetLastTopList>
			<Arg>		INT32		</Arg>
			<Arg>		INT32		</Arg>
			<Arg>		PYTHON		</Arg>
			<Arg>		INT32		</Arg>
		</onGetLastTopList>
		<requireRankInfo> <Exposed/>
			<Arg>		INT32		</Arg>
		</requireRankInfo>
		<requireLastRankInfo> <Exposed/>
			<Arg>		INT32		</Arg>
		</requireLastRankInfo>
		<requireNewSeasonReward> <Exposed/>
		</requireNewSeasonReward>
		<onGetPlayerRank>
			<Arg>		INT32		</Arg>
			<Arg>		INT32		</Arg>
			<Arg>		INT32		</Arg>
		</onGetPlayerRank>
		<onGetPlayerBattleGroundRank>
			<Arg> INT32 </Arg>
			<Arg> PY_DICT </Arg>
		</onGetPlayerBattleGroundRank>
		<onRankListOpen>
			<Arg>		INT32		</Arg>
		</onRankListOpen>
		<onRankListClose>
			<Arg>		INT32		</Arg>
		</onRankListClose>
		<updateRankValue>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg>	<!-- rank -->
			<Arg>	INT32		</Arg>	<!-- rankValue -->
		</updateRankValue>
		<updateDtsRankValue>
			<Arg>	SCORE	</Arg>
			<Arg>	PYTHON	</Arg>
		</updateDtsRankValue>
		<requireInfoCenter> <Exposed/>
		</requireInfoCenter>
		<activateInfoCenter>
		</activateInfoCenter>
		<clearInfoCenter> <Exposed/>
		</clearInfoCenter>
		<requestFriendRank> <Exposed/>
		</requestFriendRank>
		<requestFriendGoldBattleRank> <Exposed/>
			<Arg>	INT32	</Arg>
		</requestFriendGoldBattleRank>
		<requestLBSRankList> <Exposed/>
		</requestLBSRankList>
		<requestLBSPlayerRank> <Exposed/>
		</requestLBSPlayerRank>
		<updatePlayerLBSData> <Exposed/>
			<Arg> STRING </Arg>
			<Arg> STRING </Arg>
		</updatePlayerLBSData>
		<delRedHint> <Exposed/>
			<Arg> INT8 </Arg>
		</delRedHint>
		<requestFriendYuanbaoBattleRank> <Exposed/>
			<Arg>	INT32	</Arg>
		</requestFriendYuanbaoBattleRank>
		
		<reachKingSection> <Exposed/>
		</reachKingSection>

		<!-- 娱乐分 -->
		<updateEntertainRankValue> <!-- 更新娱乐分和rank -->
			<Arg> SCORE </Arg>
		</updateEntertainRankValue>
		<requireEntertainRankUpReward> <Exposed/>
			<Arg> INT32 </Arg>
		</requireEntertainRankUpReward>
		<clearEntertainInfoOnNewSeason>
		</clearEntertainInfoOnNewSeason>

		<updateEntertainNewBadge> <Exposed/>
			<Arg> BOOL </Arg>
		</updateEntertainNewBadge>

		<exchangeSeasonBountyCashToDiamond><Exposed/>
			<Arg> INT32 </Arg>
		</exchangeSeasonBountyCashToDiamond>

		<exchangeSeasonBountyCashToCash><Exposed/>
		</exchangeSeasonBountyCashToCash>

		<requireRefreshSeasonBountyInfoStatus><Exposed/>
		</requireRefreshSeasonBountyInfoStatus>

		<requestMyHistoryScore><Exposed/>
			<Arg> INT32 </Arg>
		</requestMyHistoryScore>
		<reqSeasonBountyCheckSign><Exposed/>
		</reqSeasonBountyCheckSign>
	</BaseMethods>
	<ClientMethods>
		<syncClosedRankList>
			<Arg>	ARRAY <of>	INT32	</of>		</Arg>
		</syncClosedRankList>
		<onGetPlayerRank>
			<Arg>		INT32		</Arg>
			<Arg>		INT32		</Arg>
			<Arg>		INT32		</Arg>
		</onGetPlayerRank>

		<onGetPlayerBattleGroundRank>
			<Arg> INT32 </Arg>
			<Arg> PY_DICT </Arg>
		</onGetPlayerBattleGroundRank>

		<onGetWeaponProficiencyRank>
			<Arg> INT32 </Arg>
			<Arg> PY_DICT </Arg>
		</onGetWeaponProficiencyRank>
		<onGetPlayerHotValRankInfo>
			<Arg> INT32 </Arg>
			<Arg> PY_DICT </Arg>
		</onGetPlayerHotValRankInfo>

		<onRankValueUpdate>
			<Arg>			INT32			</Arg>
			<Arg>		PLAYER_RANK_ITEM		</Arg>
		</onRankValueUpdate>

		<onRequireBattleGroundForceRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	ARRAY <of> DTS_FORCE_RANK_DATA </of>	</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireBattleGroundForceRankList>

		<onRequireBattleGroundWinningRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	ARRAY <of> DTS_WIN_RANK_DATA </of>	</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireBattleGroundWinningRankList>

		<onRequireBattleGroundKillingRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	ARRAY <of> DTS_KILL_RANK_DATA </of>	</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireBattleGroundKillingRankList>

		<onRequireGoldBattleRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	ARRAY <of> GOLD_BATTLE_RANK_DATA	</of>	</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireGoldBattleRankList>

		<onRequireYuanbaoBattleRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	ARRAY <of> YUANBAO_BATTLE_RANK_DATA	</of>	</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireYuanbaoBattleRankList>

		<onRequireRosMatchTeamRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	ARRAY <of> ROS_MATCH_TEAM_RANK_DATA	</of>	</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireRosMatchTeamRankList>

		<onGetMyRosMatchTeamRankInfo>
			<Arg>	INT64		</Arg>
			<Arg>	PYTHON		</Arg>
		</onGetMyRosMatchTeamRankInfo>

		<onRequireCampWarHumanRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	ARRAY <of>DTS_CAMP_WAR_HUMAN_RANK_DATA </of>	</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireCampWarHumanRankList>

		<onRequireCampWarInfectRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	ARRAY <of>DTS_CAMP_WAR_INFECT_RANK_DATA </of>	</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireCampWarInfectRankList>

		<onRequireCampWarOverallRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	ARRAY <of>DTS_CAMP_WAR_OVERALL_RANK_DATA </of>	</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireCampWarOverallRankList>
		<onRequireHotValRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	ARRAY <of> HOT_VAL_RANK_DATA </of>	</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireHotValRankList>
		<onRequireLastHotValRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	ARRAY <of> HOT_VAL_RANK_DATA </of>	</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireLastHotValRankList>
	
		<onRequireWeaponProficiencyRankList>
			<Arg>	INT32		</Arg>	<!-- start -->
			<Arg>	PYTHON		</Arg>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg><!-- rankType -->
		</onRequireWeaponProficiencyRankList>
		<updateDtsRankValue>
			<Arg>   SCORE  </Arg>
		</updateDtsRankValue>
		<updateMaxDtsRankValue>
			<Arg>   SCORE  </Arg>
		</updateMaxDtsRankValue>
		<onGetPlayerRankFromMS>
			<Arg>       INT32        </Arg>
			<Arg>       INT32       </Arg>
		</onGetPlayerRankFromMS>
		<onGetWeaponRankFromMS>
			<Arg>       INT32        </Arg>
			<Arg>       INT32       </Arg>
			<Arg>       INT32       </Arg>
		</onGetWeaponRankFromMS>
		<onGetNewSeasonReward>
			<Arg>       PY_DICT        </Arg>
		</onGetNewSeasonReward>
		<updateInfoCenter>
			<Arg>		BOOL		</Arg>
		</updateInfoCenter>
		<updateFriendRank>
			<Arg>		PYTHON		</Arg>
			<Arg>		BOOL		</Arg>
		</updateFriendRank>
		<updateFriendGoldBattleRank>
			<Arg>	ARRAY <of> GOLD_BATTLE_RANK_DATA	</of>	</Arg>
			<Arg>       INT32       </Arg>
			<Arg>       INT32       </Arg>
		</updateFriendGoldBattleRank>
		<updateLBSRank>
			<Arg>		PYTHON		</Arg>
			<Arg>		PYTHON		</Arg>
		</updateLBSRank>
		<onGetLBSRank>
			<Arg>		PYTHON		</Arg>
		</onGetLBSRank>
		<onUpdatePlayerLBSData>
			<Arg>		STRING		</Arg>
			<Arg>		STRING		</Arg>
		</onUpdatePlayerLBSData>
		<updateRankBadge>
			<Arg>		INT8		</Arg>
		</updateRankBadge>
		<updateFriendYuanbaoBattleRank>
			<Arg>	ARRAY <of> YUANBAO_BATTLE_RANK_DATA	</of>	</Arg>
			<Arg>       INT32       </Arg>
			<Arg>       INT32       </Arg>
		</updateFriendYuanbaoBattleRank>

		<saveLevelUpTime>
			<Arg>		PYTHON		</Arg>
		</saveLevelUpTime>
		
		<sendSeasonLevelUpAward>
			<Arg>		PYTHON		</Arg>
		</sendSeasonLevelUpAward>
		
		<sendEnterKingListAward>
			<Arg>		PYTHON		</Arg>
		</sendEnterKingListAward>
		
		<onReachKingSection>
			<Arg>		PYTHON		</Arg>
		</onReachKingSection>

		<!-- 娱乐分 -->
		<onEntertainRankUpdate>
			<Arg> SCORE </Arg>
			<Arg> INT32 </Arg>
			<Arg> SCORE </Arg>
		</onEntertainRankUpdate>

		<onRequireEntertainScoreReward>
			<Arg> INT32 </Arg>
			<Arg> PYTHON </Arg>
		</onRequireEntertainScoreReward>

		<onNewSeasonRefreshEntertainScore>
		</onNewSeasonRefreshEntertainScore>

		<onRefreshEntertainWeekScore>
		</onRefreshEntertainWeekScore>

		<onUpdateEntertainNewBadage>
			<Arg> BOOL </Arg>
		</onUpdateEntertainNewBadage>
		<updateSeasonBountyFreeCash>
			<Arg> FLOAT </Arg>
		</updateSeasonBountyFreeCash>
		<updateSeasonBountyCashCliamedDict>
			<Arg>	PYTHON 	</Arg>
		</updateSeasonBountyCashCliamedDict>
		<updateSeasonBountyFilledInfo>
			<Arg> BOOL </Arg>
		</updateSeasonBountyFilledInfo>
		<onGetMyHistoryScore>
			<Arg> PYTHON </Arg>
		</onGetMyHistoryScore>
		<onReqSeasonBountyCheckSign>
			<Arg> STRING </Arg>
		</onReqSeasonBountyCheckSign>
	</ClientMethods>
</root>
