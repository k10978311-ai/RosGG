<root>
	<Implements>
		<Interface>	iGlobal		</Interface>
		<Interface>	iBaseNoCell	</Interface>
	</Implements>
	<Properties>
		<ros2WorldLevel>
			<Type>	INT32	</Type>
			<Flags>		BASE		</Flags>
			<Default>       1       </Default>
			<Persistent>	true	</Persistent>
		</ros2WorldLevel>
		<ros2WorldLevelSeason>
			<Type>	INT32	</Type>
			<Flags>		BASE		</Flags>
			<Default>       1       </Default>
			<Persistent>	true	</Persistent>
		</ros2WorldLevelSeason>
		<ros2WorldLevelServerTaskDict>
			<Type>	PYTHON	</Type>
			<Flags>		BASE		</Flags>
			<Default>       {}       </Default>
			<Persistent>	true	</Persistent>
		</ros2WorldLevelServerTaskDict>
		<ros2WorldLevelServerTaskNumDict>
			<Type>	PYTHON	</Type>
			<Flags>		BASE		</Flags>
			<Default>       {}       </Default>
			<Persistent>	true	</Persistent>
		</ros2WorldLevelServerTaskNumDict>
		<canPlayRos2Game>
			<Type>	BOOL	</Type>
			<Flags>		BASE		</Flags>
			<Default>       1       </Default>
		</canPlayRos2Game>
		<ros2WorldLevelServerTask>
			<Type>	BOOL	</Type>
			<Flags>		BASE		</Flags>
			<Default>       0       </Default>
			<Persistent>	true	</Persistent>
		</ros2WorldLevelServerTask>
		<ros2WorldLevelTaskNum>
			<Type>	INT32	</Type>
			<Flags>		BASE		</Flags>
			<Default>       0       </Default>
		</ros2WorldLevelTaskNum>
		<ros2WorldLevelRankListCache>
			<Type>	ARRAY <of>	INT32	</of>	</Type>
			<Flags>		BASE		</Flags>
			<Default>    []    </Default>
		</ros2WorldLevelRankListCache>
		<ros2WorldLevelAllSeasonRankCache>
			<Type>	PYTHON	</Type>
			<Flags>		BASE		</Flags>
			<Default>    {}    </Default>
		</ros2WorldLevelAllSeasonRankCache>

		<ros2AllWealth>
			<Type>	INT32	</Type>
			<Flags>		BASE		</Flags>
			<Default>       0      </Default>
			<Persistent>	true	</Persistent>
		</ros2AllWealth>
		<ros2ComfortLevel>
			<Type>	INT32	</Type>
			<Flags>		BASE		</Flags>
			<Default>       0      </Default>
			<Persistent>	true	</Persistent>
		</ros2ComfortLevel>
		<ros2CashActivityDayNo>
			<Type>		 INT32 		</Type>
			<Flags>			BASE		</Flags>
			<Default>       0       </Default>
			<Persistent>	true	</Persistent>
		</ros2CashActivityDayNo>
		<ros2CashPool>
			<Type>		 FLOAT 		</Type>
			<Flags>		BASE		</Flags>
			<Persistent>	true	</Persistent>
		</ros2CashPool>
	</Properties>
	<BaseMethods>
		<queryRos2WorldLevel>
		</queryRos2WorldLevel>
		<queryCanPlayRos2Game>
		</queryCanPlayRos2Game>
		<queryRos2WorldLevelSeason>
		</queryRos2WorldLevelSeason>

		<queryRos2WorldLevelTaskNum>
			<Arg>		MAILBOX			</Arg>
		</queryRos2WorldLevelTaskNum>
		<queryRos2WorldLevelTaskNumDict>
			<Arg>		MAILBOX			</Arg>
		</queryRos2WorldLevelTaskNumDict>

		<queryRos2WorldLevelRank>
			<Arg>		MAILBOX			</Arg>
			<Arg>		INT8			</Arg>
			<Arg>		INT8			</Arg>
		</queryRos2WorldLevelRank>

		<updateRos2WorldLevelTaskNum>
			<Arg>		INT32			</Arg>
			<Arg>		FLOAT			</Arg>
			<Arg>		FLOAT			</Arg>
			<Arg>		INT8			</Arg>
			<Arg>		INT8			</Arg>
		</updateRos2WorldLevelTaskNum>
		<updateRos2PlayerWealth>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
		</updateRos2PlayerWealth>
		<updateRos2PlayerComfortLevel>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
		</updateRos2PlayerComfortLevel>
		<queryRos2WorldLevelPlayerRank>
			<Arg>		MAILBOX			</Arg>
			<Arg>		INT32			</Arg>
			<Arg>		INT8			</Arg>
			<Arg>		INT8			</Arg>
		</queryRos2WorldLevelPlayerRank>

		<sendWorldLevelServerReward>
			<Arg>		MAILBOX			</Arg>
			<Arg>		INT8			</Arg>
			<Arg>		INT8			</Arg>
		</sendWorldLevelServerReward>
		<sendWorldLevelServerRankReward>
			<Arg>		MAILBOX			</Arg>
			<Arg>		INT32			</Arg>
			<Arg>		INT8			</Arg>
			<Arg>		INT8			</Arg>
		</sendWorldLevelServerRankReward>
		<syncRos2CashPool>
			<Arg>		INT32		</Arg>
			<Arg>		INT32		</Arg>
		</syncRos2CashPool>
	</BaseMethods>
</root>
