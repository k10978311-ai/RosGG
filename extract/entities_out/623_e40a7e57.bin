<root>
	<Properties>
		<newLevelup>
			<Type> BOOL </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
		</newLevelup>
		<newRos2Levelup>
			<Type> BOOL </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
		</newRos2Levelup>
		<dtsRos2Exp>
			<Type>		INT32		</Type>
			<Flags>		BASE_AND_CLIENT	</Flags>
			<Default> 0 </Default>
			<PersistentMongo>	true			</PersistentMongo>
		</dtsRos2Exp>
		<dtsRos2Level>
			<Type>		INT32		</Type>
			<Flags>		BASE_AND_CLIENT	</Flags>
			<Default> 1 </Default>
			<PersistentMongo>	true			</PersistentMongo>
		</dtsRos2Level>
		<dtsRos2ExpSeasonData>
			<Type>		PYTHON		</Type>
			<Flags>		BASE_AND_CLIENT	</Flags>
			<Default> {} </Default>
			<PersistentMongo>	true			</PersistentMongo>
		</dtsRos2ExpSeasonData>
	</Properties>

	<BaseMethods>
		<addDtsExp>
			<Arg>			INT32				</Arg>
			<Arg>			INT32				</Arg>
			<Arg>			INT32				</Arg>
		</addDtsExp>
		<addRos2DtsExp>
			<Arg>			INT32				</Arg>
			<Arg>			INT32				</Arg>
			<Arg>			INT32				</Arg>
		</addRos2DtsExp>

		<requestDtsLevelAward> <Exposed/>
			<Arg>			INT32				</Arg>
		</requestDtsLevelAward>
		<onUIDtsLevelUpShown> <Exposed/>
		</onUIDtsLevelUpShown>
		<addAthleteExpIntoExtraBattleAward>
			<Arg>	INT32		</Arg>
			<Arg>	INT32		</Arg>
		</addAthleteExpIntoExtraBattleAward>
	</BaseMethods>

	<ClientMethods>
		<onCheckSpecialAwardState>
			<Arg>			DTS_LEVEL_SPECIAL_AWARD_STATE			</Arg>
		</onCheckSpecialAwardState>

		<onAddDtsExp>
			<Arg>			INT32				</Arg>
			<Arg>			INT32				</Arg>
			<Arg>			BOOL				</Arg>
		</onAddDtsExp>

		<onAddRos2DtsExp>
			<Arg>			INT32				</Arg>
			<Arg>			INT32				</Arg>
			<Arg>			BOOL				</Arg>
		</onAddRos2DtsExp>

		<onRequestDtsLevelAward>
			<Arg>			INT32				</Arg>
			<Arg> ARRAY <of> INT32 </of> </Arg>
		</onRequestDtsLevelAward>

		<syncRos2ExpSeasonData>
			<Arg>			PYTHON				</Arg>
		</syncRos2ExpSeasonData>
	</ClientMethods>
</root>
