		<updateFollowPatrolPoint>
			<Arg>			VECTOR3			</Arg>
			<Arg>			ENTITY_ID		</Arg>
		</updateFollowPatrolPoint>
		
		<onRos2AvatarMarkedByLandDrone>
			<Arg>		INT32		</Arg>
