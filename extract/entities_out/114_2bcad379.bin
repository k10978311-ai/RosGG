	<CellMethods>
		<onGameStart>
			<Arg>	ARRAY <of>	FLOAT	</of>	</Arg>
		</onGameStart>
		<shootHit><Exposed/>
			<Arg> SHOOT_WEAPON_INFO </Arg>
			<Arg> VECTOR3 </Arg>
			<Arg> ENTITY_ID </Arg>
			<Arg> HIT_PART </Arg>
			<Arg> VECTOR3 </Arg>
			<Arg> INT32	</Arg>
		</shootHit>
		<addDtsBotItem>
			<Arg>			INT32			</Arg>  <!--itemID-->
			<Arg>			INT32			</Arg>  <!--number-->
			<Arg>			PYTHON			</Arg>  <!--info-->
		</addDtsBotItem>
		<syncRobotTeammates>
			<Arg>	ARRAY <of>  INT32  </of>	</Arg>
		</syncRobotTeammates>
		<fakeDie>
			<Arg>			PYTHON			</Arg>
			<Arg>			PYTHON			</Arg>
			<Arg>			PYTHON			</Arg>
		</fakeDie>
